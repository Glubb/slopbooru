# Example Caddyfile for multiple Slopbooru boards under subpaths on one domain.
# Customize domain, board names, ports, and root paths.
# Place this in your Caddy config (e.g. /etc/caddy/Caddyfile) and reload with `caddy reload`.

example.com {
    header Permissions-Policy "interest-cohort=()"

    # Main static site (served from a separate directory)
    root * /home/websites/main-site
    file_server browse

    # Example board 1: blog mode under /board1/
    handle /board1/* {
        # Serve static assets directly from the board dir for performance
        handle_path /board1/src/* {
            root * /home/websites/slopbooru/board1
            file_server
        }
        handle_path /board1/thumb/* {
            root * /home/websites/slopbooru/board1
            file_server
        }
        handle_path /board1/css/* {
            root * /home/websites/slopbooru/board1
            file_server
        }

        # Proxy dynamic requests (and the board's dynamic pages like /board1/admin, /board1/123 etc)
        # We use handle_path here so the *prefix is stripped* for the backend; the app still
        # uses base_path (passed to make_app) to generate correct script_root for links, forms,
        # cookies and redirects (so browser requests come back with /board1/... and match the
        # outer handle). The python code is also tolerant of receiving the full prefixed path
        # (in case you prefer plain `handle /board1/* { reverse_proxy }` without _path).
        handle_path /board1/* {
            reverse_proxy 127.0.0.1:8001
        }
    }

    # Example board 2: imageboard mode under /board2/
    handle /board2/* {
        handle_path /board2/src/* {
            root * /home/websites/slopbooru/board2
            file_server
        }
        handle_path /board2/thumb/* {
            root * /home/websites/slopbooru/board2
            file_server
        }
        handle_path /board2/css/* {
            root * /home/websites/slopbooru/board2
            file_server
        }

        handle_path /board2/* {
            reverse_proxy 127.0.0.1:8002
        }
    }

    # Add more boards as needed. Use different ports in gunicorn services.
    # For each board, run a separate systemd service with its own port and base_path.
}
