# User board configuration (contains secrets like ADMIN_PASS, SECRET, CAPPED_TRIPS, etc.)
# Always use config.py.example as the template and create your own config.py
/config.py

# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class
.Python

# Local test / development board instances
blogboard/
testboard/
venv/
env/
ENV/

# Board runtime data (when the project root or subdirs are used as boards)
# Thread storage, thumbnails, uploaded media — never commit these
res/*
!res/.gitkeep
thumb/*
!thumb/.gitkeep

# Board image upload dir (IMG_DIR). Only src/kareha/ is the Python package — not uploads.
/src/
!/src/kareha/
!/src/kareha/**
/src/kareha/**/__pycache__/

# OS / editor noise
.DS_Store
*.swp
*~
.idea/
.vscode/
*.sublime-*

# Logs and temporary files
*.log
*.tmp
*.bak

# Distribution / packaging (if you build wheels/sdist)
build/
dist/
*.egg-info/

# Personal deployment systemd units (for user's server)
systemd/

# Agent continuity notes (local only, never push)
.agent-worklog.md

# Board runtime / moderation data (use reports.json.example as template)
/reports.json
banned_ips.txt
banned_md5.txt
.runtime/
log.txt
error.log
